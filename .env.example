# Copy to .env.local and fill in. See docs/SETUP.md.
# Server-only credentials: do NOT prefix these with NEXT_PUBLIC_.
# Names are case-sensitive on Vercel: use exactly SUPABASE_URL and SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Stripe Connect (test mode). Put real keys only in .env.local, never in this file.
# The secret key and webhook secret are server-only. The publishable key is the one
# NEXT_PUBLIC_ variable: it is meant to be public.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
